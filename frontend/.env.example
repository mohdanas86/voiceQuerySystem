# AssemblyAI — server-side transcription
ASSEMBLYAI_API_KEY=

# EmailJS — server-side ONLY (no NEXT_PUBLIC_ prefix — keys never sent to browser)
EMAILJS_PUBLIC_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_CUSTOMER_TEMPLATE_ID=customer_confirmation
EMAILJS_OPS_TEMPLATE_ID=ops_notification
EMAILJS_PRIVATE_KEY=   # (Optional) Private Key / Access Token to authenticate server-side requests securely

# MongoDB Atlas — store successful query submissions
MONGODB_URI=
MONGODB_DB=voiceQuerySystem

# Supabase Storage — store voice recordings
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Translation (client-side proxy via /api/translate)
NEXT_PUBLIC_LIBRETRANSLATE_URL=https://libretranslate.de/translate
